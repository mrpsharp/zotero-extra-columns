{
  "name": "zotero-extra-columns",
  "type": "module",
  "version": "0.1.0",
  "description": "Show values stored in an item's Extra field as sortable columns in the Zotero item list.",
  "config": {
    "addonName": "Extra Columns",
    "addonID": "extra-columns@petersharp.org",
    "addonRef": "extra-columns",
    "addonInstance": "ExtraColumns",
    "prefsPrefix": "extensions.zotero.extra-columns"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpsharp/zotero-extra-columns.git"
  },
  "author": "Peter Sharp",
  "bugs": {
    "url": "https://github.com/mrpsharp/zotero-extra-columns/issues"
  },
  "homepage": "https://github.com/mrpsharp/zotero-extra-columns#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "npm run test:unit",
    "test:unit": "mocha --import=tsx \"test/unit/**/*.test.ts\"",
    "test:zotero": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
